#!/bin/sh
# The full suite runs once, here, before every commit - the gate that keeps a
# red suite off the remote. Iterate with a narrow `uv run pytest tests/test_x.py`;
# this is the final check, not the feedback loop. Skip deliberately with
# `git commit --no-verify` (a docs-only commit, say) and know that you did.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-commit: running the full test suite (about three minutes)..."
uv run pytest -q -p no:cacheprovider
status=$?
if [ $status -ne 0 ]; then
  echo "pre-commit: tests failed - commit refused. Fix them, or --no-verify if you must."
fi
exit $status
